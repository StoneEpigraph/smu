{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SMU",
  "version": "0.1.1",
  "identifier": "cn.stonemind.smu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3535",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SMU",
        "width": 900,
        "height": 750,
        "minWidth": 900,
        "minHeight": 750,
        "resizable": true,
        "center": true,
        "decorations": true,
        "alwaysOnTop": true,
        "visible": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "StoneMind",
    "copyright": "© 2025 StoneMind",
    "shortDescription": "SMU 工具箱",
    "license": "MIT",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "digestAlgorithm": "sha256",
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      },
      "rpm": {
        "release": "1",
        "depends": ["webkit2gtk4.1", "gtk3", "libappindicator-gtk3"]
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:krunner.db"]
    }
  }
}